# Single channel (legacy). Still supported.
CHANNEL=miantiao_me

# Multiple channels (aggregation). Comma or semicolon separated.
# When set, it takes precedence over CHANNEL and merges every channel into one feed.
# Bare usernames only (t.me/ prefixes are stripped automatically).
# CHANNELS=miantiao_me,durov,somechannel

# Optional site identity for the aggregated feed (overrides the first channel's title/description).
SITE_TITLE=
SITE_DESCRIPTION=

LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

TELEGRAM=miantiao_me
TWITTER=miantiao_me
GITHUB=miantiao-me
DISCORD=https://DISCORD.com
PODCAST=https://PODCAST.com
MASTODON=mastodon.social/@Mastodon
BLUESKY=bsky.app

FOOTER_INJECT=
# Base is always loaded. Optionally load one trusted-admin override; never combine themes.
# See THEMES.md for every built-in path, platform values, custom CSS, and security notes.
# HEADER_INJECT='<link rel="stylesheet" href="/themes/aria.css">'
HEADER_INJECT=

# --- Subscription call-to-action (reserve a spot to drive follows/subscribes) ---
# When SUBSCRIBE_URL is set, a banner appears under the header linking to your update page.
# Example: https://jinbufenzi.com/go/be9666
SUBSCRIBE_URL=
SUBSCRIBE_TEXT=订阅更新
SUBSCRIBE_ENABLED=true

# --- Ad slots (HTML and/or JS). All ad content is scanned by the safety filter; any
# adult / gambling / drug / gray-black financial creative is rejected automatically. ---
# Master switch for every ad slot and AD_JS.
AD_ENABLED=true
# HTML injected at the top of the feed (and above a single post).
AD_SLOT_TOP=
# HTML injected between posts in the feed, every AD_EVERY posts.
AD_SLOT_INLINE=
# HTML injected at the bottom of the page (above the footer).
AD_SLOT_BOTTOM=
# Raw JS snippet injected once before </body> (e.g. an ad-network auto-ads loader).
AD_JS=
# Inline-ad cadence for AD_SLOT_INLINE.
AD_EVERY=5

# --- Content safety filter ---
# Block adult / gambling / drug / gray-black financial posts from the feed and RSS.
# Net-disk resource sharing and ordinary content are allowed. Set to false to disable.
CONTENT_FILTER=true

NOFOLLOW=false
NOINDEX=false
HIDE_DESCRIPTION=false

TELEGRAM_HOST=telegram.dog
STATIC_PROXY=""
# Adapter selection is automatic. EdgeOne is detected through std-env's edgeone_pages
# provider or platform-provided EDGEONE_PROJECT_ID/EO_MAKERS. Override only when needed.
SERVER_ADAPTER=""
# Append hostname-only proxy targets to the default whitelist, separated by commas.
TARGET_WHITELIST=""
GOOGLE_SEARCH_SITE=""
TAGS=""
COMMENTS=""
REACTIONS=""
LINKS=""
NAVS=""
RSS_BEAUTIFY=""
