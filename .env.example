# Single channel (legacy). Still supported.
CHANNEL=miantiao_me

# Multiple channels (aggregation). Comma or semicolon separated.
# When set, it takes precedence over CHANNEL and merges every channel into one feed.
# Bare usernames only (t.me/ prefixes are stripped automatically).
# CHANNELS=miantiao_me,durov,somechannel

# Optional site identity for the aggregated feed (overrides the first channel's title/description).
SITE_TITLE=
SITE_DESCRIPTION=

LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

TELEGRAM=miantiao_me
TWITTER=miantiao_me
GITHUB=miantiao-me
DISCORD=https://DISCORD.com
PODCAST=https://PODCAST.com
MASTODON=mastodon.social/@Mastodon
BLUESKY=bsky.app

FOOTER_INJECT=
# Base is always loaded. Optionally load one trusted-admin override; never combine themes.
# See THEMES.md for every built-in path, platform values, custom CSS, and security notes.
# HEADER_INJECT='<link rel="stylesheet" href="/themes/aria.css">'
HEADER_INJECT=

NOFOLLOW=false
NOINDEX=false
HIDE_DESCRIPTION=false

TELEGRAM_HOST=telegram.dog
STATIC_PROXY=""
# Adapter selection is automatic. EdgeOne is detected through std-env's edgeone_pages
# provider or platform-provided EDGEONE_PROJECT_ID/EO_MAKERS. Override only when needed.
SERVER_ADAPTER=""
# Append hostname-only proxy targets to the default whitelist, separated by commas.
TARGET_WHITELIST=""
GOOGLE_SEARCH_SITE=""
TAGS=""
COMMENTS=""
REACTIONS=""
LINKS=""
NAVS=""
RSS_BEAUTIFY=""
