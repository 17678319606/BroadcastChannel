{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhongnianren",
  "main": "./node_modules/@astrojs/cloudflare/dist/entrypoints/server.js",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "kv_namespaces": [
    { "binding": "FEED_CACHE", "id": "190bd664a9b34bc4af94e070d3ea9019" }
  ]
}
