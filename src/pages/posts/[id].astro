---
import PostsPage from '../../components/PostsPage.astro'
import { getChannelInfoCached, getPostContext } from '../../lib/telegram'
import { getKVBinding } from '../../lib/cloudflare'

if (!Astro.params.id) {
  return Astro.redirect('/')
}

// Fresh, accurate post + navigation context (prev/next/related). Always fetched
// so the latest parsing (link restoration, ad filtering) is applied and so older
// posts outside the cached "latest" window still get correct neighbours.
const context = await getPostContext(Astro.params.id)
const post = context.post

if (!post) {
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Cache-Control': 'public, max-age=300, s-maxage=300',
    },
  })
}

// Site-level metadata (title / avatar / description) comes from the cached
// aggregate — cheap and stable across detail pages.
const siteInfo = await getChannelInfoCached({}, getKVBinding())
const channel = {
  ...(siteInfo || {}),
  posts: [post],
}
---

<PostsPage
  channel={channel}
  before={false}
  after={false}
  isDetail={true}
  pageHeading={post.title || channel.title}
  pageSeo={{ title: post.title, text: post.description, publishedTime: post.datetime }}
  pageType="post"
  prevPost={context.prev}
  nextPost={context.next}
  relatedPosts={context.related}
/>
