---
import PostsPage from '../../components/PostsPage.astro'
import NotFound from '../../components/NotFound.astro'
import { getChannelInfoCached, getChannelPostCached, getPostContextCached } from '../../lib/telegram'
import { getKVBinding } from '../../lib/cloudflare'

if (!Astro.params.id) {
  return Astro.redirect('/')
}

const kv = getKVBinding()
const siteInfo = await getChannelInfoCached({}, kv)

// Cached, resilient post + navigation context (prev/next/related). The cache
// sits behind KV and serves a stale copy if Telegram is slow/down, so a detail
// page never 500s just because the upstream blinked. Falls back to an empty
// context on total failure (post then resolved via the cached feed / cached
// single-post lookup below).
const EMPTY_CONTEXT = { post: null, prev: null, next: null, related: [] }
let context = await getPostContextCached(Astro.params.id, kv).catch(() => EMPTY_CONTEXT)
let post = context.post

// Resilience chain (defense in depth):
//  1. cached detail context (KV, stale-while-error)
//  2. the cached aggregate "latest" feed (already in siteInfo)
//  3. a cached single-post fetch (KV, stale-while-error)
// Navigation may be absent in the fallback, but the article still renders
// instead of 404ing on a transient upstream error.
if (!post) {
  post = siteInfo.posts.find((item) => item.id === Astro.params.id)
    ?? (await getChannelPostCached(Astro.params.id, kv).catch(() => null))
  if (post) {
    context = { post, prev: null, next: null, related: [] }
  }
}

const notFound = !post
if (notFound) {
  Astro.response.status = 404
}
---

{
  notFound ? (
    <NotFound heading="文章不存在" description="您访问的文章不存在、已被移除，或链接已过期。" />
  ) : (
    <PostsPage
      channel={{ ...(siteInfo || {}), posts: [post as NonNullable<typeof post>] }}
      before={false}
      after={false}
      isDetail={true}
      pageHeading={post!.title || (siteInfo as { title?: string }).title}
      pageSeo={{ title: post!.title, text: post!.description, publishedTime: post!.datetime }}
      pageType="post"
      prevPost={context.prev}
      nextPost={context.next}
      relatedPosts={context.related}
    />
  )
}
