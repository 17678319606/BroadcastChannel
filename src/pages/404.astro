---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getEnv } from '../lib/env'

const siteTitle = getEnv(import.meta.env, 'SITE_TITLE') || 'Home'
---

<BaseLayout
  channel={{ posts: [], title: siteTitle, description: '', descriptionHTML: null, avatar: undefined }}
  pageClass="feed"
  pageType="home"
  seo={{
    title: '页面未找到 — 404',
    description: '您访问的页面不存在或已被移除。',
    noindex: true,
  }}
>
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">页面走丢了</h1>
    <p class="not-found__desc">您访问的页面不存在、已被移除，或链接已过期。</p>
    <div class="not-found__actions">
      <a href="/" class="not-found__btn not-found__btn--primary">← 返回首页</a>
      <a href="javascript:history.back()" class="not-found__btn not-found__btn--secondary">返回上页</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 2rem;
    min-height: 45vh;
  }

  .not-found__code {
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 900;
    line-height: 1;
    color: var(--muted-color, #9ca3af);
    opacity: 0.35;
    margin: 0;
    letter-spacing: -0.04em;
  }

  .not-found__title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--heading-color, #1f2937);
    margin: 0.8rem 0 0.6rem;
  }

  .not-found__desc {
    font-size: 1rem;
    color: var(--muted-color, #6b7280);
    max-width: 36rem;
    margin: 0 0 2rem;
    line-height: 1.65;
  }

  .not-found__actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .not-found__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .not-found__btn--primary {
    background: var(--accent-color, #3b82f6);
    color: #fff;
    border: none;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
  }

  .not-found__btn--primary:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.32);
  }

  .not-found__btn--secondary {
    background: transparent;
    color: var(--link-color, #3b82f6);
    border: 1px solid var(--border-color, #e5e7eb);
  }

  .not-found__btn--secondary:hover {
    border-color: var(--accent-color, #3b82f6);
    background: var(--accent-background, #eff6ff);
  }
</style>
