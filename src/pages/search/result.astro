---
import PostsPage from '../../components/PostsPage.astro'
import { getChannelInfoCached } from '../../lib/telegram'
import { getKVBinding } from '../../lib/cloudflare'
import type { SeoMeta } from '../../types'

const q = Astro.url.searchParams.get('q') || ''
const channel = await getChannelInfoCached(
  {
    q,
  },
  getKVBinding(),
)
const pageSeo: SeoMeta = {
  title: q,
  noindex: true,
}
---

<PostsPage
  channel={channel}
  before={false}
  after={false}
  pageClass="feed"
  pageHeading={`Search: ${q}`}
  pageSeo={pageSeo}
  pageType="page"
/>
