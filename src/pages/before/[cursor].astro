---
import PostsPage from '../../components/PostsPage.astro'
import { decodeCursorMap, getChannelInfoCached } from '../../lib/telegram'
import { getKVBinding } from '../../lib/cloudflare'
import type { SeoMeta } from '../../types'

// Decode the cursor safely — malformed cursors fall back to {} (latest page).
const decodedCursor = decodeCursorMap(Astro.params.cursor)
const channel = await getChannelInfoCached({ before: decodedCursor }, getKVBinding())
const pageParam = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1)
const pageSeo: SeoMeta = {
  noindex: true,
}

// If the cursor resolved to empty (user typed URL manually, or a stale
// pagination link pointed past the end of the feed), redirect to home
// rather than showing a confusing blank page or 404.
const hasPosts = (channel.posts?.length ?? 0) > 0
if (!hasPosts) {
  return Astro.redirect('/')
}
---

<PostsPage
  channel={channel}
  pageClass="feed"
  pageHeading={channel.title}
  pageSeo={pageSeo}
  pageType="home"
  page={pageParam}
/>
