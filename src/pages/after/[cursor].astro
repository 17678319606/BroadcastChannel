---
import PostsPage from '../../components/PostsPage.astro'
import { decodeCursorMap, getChannelInfoCached } from '../../lib/telegram'
import { getKVBinding } from '../../lib/cloudflare'
import type { SeoMeta } from '../../types'

const channel = await getChannelInfoCached(
  {
    after: decodeCursorMap(Astro.params.cursor),
  },
  getKVBinding(Astro.locals),
)
const pageParam = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1)
const pageSeo: SeoMeta = {
  noindex: true,
}
---

<PostsPage
  channel={channel}
  pageClass="feed"
  pageHeading={channel.title}
  pageSeo={pageSeo}
  pageType="home"
  page={pageParam}
/>
