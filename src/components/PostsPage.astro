---
import BaseLayout from '../layouts/BaseLayout.astro'
import AdSlot from '../components/AdSlot.astro'
import PostEntry from '../components/PostEntry.astro'
import { buildChannelCursor, encodeCursorMap } from '../lib/telegram'
import { getAdEvery } from '../lib/ads'
import { getPageSize } from '../lib/env'
import type { ChannelInfo, SeoMeta } from '../types'

const {
  channel,
  before: showOlder = true,
  after: showNewer = true,
  isDetail = false,
  pageClass,
  pageHeading,
  pageSeo,
  pageType,
} = Astro.props as {
  channel: ChannelInfo
  before?: boolean
  after?: boolean
  isDetail?: boolean
  pageClass?: string
  pageHeading?: string
  pageSeo?: SeoMeta
  pageType: 'home' | 'post' | 'page'
}

// Slice the aggregated feed to PAGE_SIZE. The pagination cursor MUST be built
// from this sliced window, not the full upstream list — otherwise "older"/"newer"
// would jump to the absolute extremes of the feed instead of the next page.
const pageSize = getPageSize(import.meta.env)
const allPosts = channel.posts ?? []
const posts = allPosts.slice(0, pageSize)

const beforeCursor = (() => {
  const map = buildChannelCursor(posts, 'before')
  return map ? encodeCursorMap(map) : ''
})()
const afterCursor = (() => {
  const map = buildChannelCursor(posts, 'after')
  return map ? encodeCursorMap(map) : ''
})()
const olderHref = beforeCursor ? new URL(`before/${beforeCursor}`, Astro.url).toString() : ''
const newerHref = afterCursor ? new URL(`after/${afterCursor}`, Astro.url).toString() : ''
const hasOlderPosts = showOlder && Boolean(beforeCursor)
const hasNewerPosts = showNewer && Boolean(afterCursor)

// Inline ad cadence (only meaningful on aggregated feed pages, not single-post views).
const inlineAdEvery = isDetail ? 0 : getAdEvery(import.meta.env)

// Article structured data for rich search results on a single post page.
const jsonLd =
  pageType === 'post' && posts[0]
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: posts[0].title || channel.title,
        datePublished: posts[0].datetime,
        dateModified: posts[0].datetime,
        author: { '@type': 'Organization', name: channel.title },
        publisher: {
          '@type': 'Organization',
          name: channel.title,
          logo: channel.avatar ? { '@type': 'ImageObject', url: channel.avatar } : undefined,
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': Astro.url.toString(),
        },
        description: posts[0].description || posts[0].text?.slice(0, 160),
      }
    : undefined
---

<BaseLayout
  channel={channel}
  pageClass={pageClass}
  seo={pageSeo}
  structuredData={jsonLd}
  pageType={pageType}
  prevUrl={hasNewerPosts ? newerHref : undefined}
  nextUrl={hasOlderPosts ? olderHref : undefined}
>
  {pageHeading ? <h1 class="sr-only">{pageHeading}</h1> : null}
  <slot name="header" />
  {
    posts.length === 0 ? (
      <p class="empty-state">暂无内容。请检查频道配置或稍后重试。</p>
    ) : (
      <ol class="posts-feed" aria-label={isDetail ? 'Post' : 'Posts'}>
        {posts.map((post, index) => (
          <Fragment>
            <li>
              <PostEntry post={post} isDetail={isDetail} />
            </li>
            {inlineAdEvery > 0 && !isDetail && (index + 1) % inlineAdEvery === 0 && index < posts.length - 1 ? (
              <li class="ad-slot-wrap" aria-hidden="false">
                <AdSlot name="AD_SLOT_INLINE" />
              </li>
            ) : null}
          </Fragment>
        ))}
      </ol>
    )
  }

  {
    hasOlderPosts || hasNewerPosts ? (
      <nav class="pagination" aria-label="Pagination">
        {hasNewerPosts ? (
          <a
            href={newerHref}
            rel="prev"
            class="pagination__link pagination__link--newer"
            title="更新的内容"
            aria-label="更新的内容"
          >
            <span aria-hidden="true">←</span>
            <span class="pagination__label">更新</span>
          </a>
        ) : (
          <span class="pagination__spacer" aria-hidden="true" />
        )}
        <span class="pagination__status" aria-hidden="true">
          {posts.length} 条
        </span>
        {hasOlderPosts ? (
          <a
            href={olderHref}
            rel="next"
            class="pagination__link pagination__link--older"
            title="更早的内容"
            aria-label="更早的内容"
          >
            <span class="pagination__label">更早</span>
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="pagination__spacer" aria-hidden="true" />
        )}
      </nav>
    ) : null
  }
</BaseLayout>
