{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broadcast-channel",
  // Astro's Cloudflare adapter rewrites this to dist/server/wrangler.json after build.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
  // --- Runtime variables (non-secret) ---
  // Plaintext vars here are exposed to the app at runtime and are fine for public
  // config like channel names. For anything sensitive, use `wrangler secret put`
  // (or the Workers dashboard) instead — those are encrypted and not stored in this file.
  // `keep_vars: true` above means dashboard/secret values are preserved across deploys.
  //
  // "vars": {
  //   "CHANNELS": "miantiao_me,durov",
  //   "SITE_TITLE": "",
  //   "SITE_DESCRIPTION": "",
  //   "LOCALE": "zh-CN",
  //   "TIMEZONE": "Asia/Shanghai",
  //   "PAGE_SIZE": "30"
  // }
}
