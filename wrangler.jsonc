{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "123yunpan",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "kv_namespaces": [
    { "binding": "FEED_CACHE", "id": "PASTE_FEED_CACHE_ID_HERE" }
  ]
}
